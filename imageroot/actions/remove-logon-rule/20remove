# Remove a logon rule in steps (see pypkg/removal.py): start, cancel, or
# delete when the waiting period is over. Windows restores the logon
# rights of before on each computer that sees the start.

import json
import sys

import agent
import removal
import wdcommon

request = json.load(sys.stdin)


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


with wdcommon.logon_locked() as data:
    rule = next((r for r in data["rules"] if r["id"] == request["id"]), None)
    if rule is None:
        fail("id", request["id"], "rule_not_found")
    step = request["step"]
    try:
        if step == "start":
            pending = removal.start_logon(rule, request["reason"], request.get("days"))
            result = {"step": step, "until": pending["until"]}
        elif step == "cancel":
            removal.cancel_logon(rule, request["reason"])
            result = {"step": step}
        else:
            removal.purge_logon(data, rule, request["reason"])
            result = {"step": step}
    except removal.RemovalError as ex:
        fail("step", step, ex.code)
    except (wdcommon.ToolError, ValueError) as ex:
        print(agent.SD_ERR + f"removing the logon rule ({step}) failed: {ex}", file=sys.stderr)
        sys.exit(1)

print(agent.SD_INFO + f"logon rule {rule['name']!r}: removal step {step}", file=sys.stderr)
json.dump(result, fp=sys.stdout)
