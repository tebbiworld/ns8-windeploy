import json
import os
import sys

import agent
import modsecrets
import wdcommon
import wingetindex

env = os.environ
try:
    with open("rights.json") as f:
        rights = json.load(f)
except (FileNotFoundError, json.JSONDecodeError):
    rights = None

json.dump({
    "domain": env.get("GPO_DOMAIN", ""),
    "dc_host": env.get("GPO_DC_HOST", ""),
    "dc_ip": env.get("GPO_DC_IP", ""),
    "realm": env.get("GPO_REALM", ""),
    "workgroup": env.get("GPO_WORKGROUP", ""),
    "username": env.get("GPO_USER", ""),
    "password_set": bool(modsecrets.get("GPO_PASSWORD")),
    "default_delivery": env.get("DEFAULT_DELIVERY", "sysvol"),
    "domains": wdcommon.ns8_domains(),
    "effective": wdcommon.connection_settings(),
    "rights": rights,
    "index": wingetindex.read_meta(wdcommon.state_dir()),
    "deployments": len(wdcommon.read_deployments()["deployments"]),
}, fp=sys.stdout)
