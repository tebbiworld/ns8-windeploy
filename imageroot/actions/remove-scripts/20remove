# Remove a script set in steps (see pypkg/removal.py): start, cancel, or
# delete when the waiting period is over. While waiting, the cleanup
# scripts run instead of the scripts.

import json
import sys

import agent
import removal
import wdcommon

request = json.load(sys.stdin)


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


with wdcommon.scripts_locked() as data:
    item = next((r for r in data["sets"] if r["id"] == request["id"]), None)
    if item is None:
        fail("id", request["id"], "set_not_found")
    step = request["step"]
    try:
        if step == "start":
            pending = removal.start_scripts(item, request["reason"], request.get("days"))
            result = {"step": step, "until": pending["until"]}
        elif step == "cancel":
            removal.cancel_scripts(item, request["reason"])
            result = {"step": step}
        else:
            removal.purge_scripts(data, item, request["reason"])
            result = {"step": step}
    except removal.RemovalError as ex:
        fail("step", step, ex.code)
    except (wdcommon.ToolError, ValueError) as ex:
        print(agent.SD_ERR + f"removing the script set ({step}) failed: {ex}", file=sys.stderr)
        sys.exit(1)

print(agent.SD_INFO + f"script set {item['name']!r}: removal step {step}", file=sys.stderr)
json.dump(result, fp=sys.stdout)
