# Remove a policy profile in steps (see pypkg/removal.py): start, cancel,
# or delete when the waiting period is over.
#
# Windows removes registry policy and restores user rights by itself
# when the GPO is gone. Audit settings and registry values outside the
# policy keys stay on the computers as they were set (see policygen):
# start makes the GPO write the Windows defaults for those, and the
# waiting period gives the computers time to apply them.

import json
import sys

import agent
import policygen
import removal
import wdcommon

request = json.load(sys.stdin)


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


with wdcommon.policies_locked() as data:
    profile = next((p for p in data["profiles"] if p["id"] == request["id"]), None)
    if profile is None:
        fail("id", request["id"], "profile_not_found")
    step = request["step"]
    try:
        if step == "start":
            pending = removal.start_profile(profile, request["reason"], request.get("days"))
            result = {"step": step, "until": pending["until"],
                      "resets": sorted(sid for sid, e in profile["settings"].items() if e["state"] == "reset")}
        elif step == "cancel":
            removal.cancel_profile(profile, request["reason"])
            result = {"step": step}
        else:
            removal.purge_profile(data, profile, request["reason"])
            result = {"step": step}
    except removal.RemovalError as ex:
        fail("step", step, ex.code)
    except (wdcommon.ToolError, ValueError, policygen.PolicyError) as ex:
        print(agent.SD_ERR + f"removing the policy profile ({step}) failed: {ex}", file=sys.stderr)
        sys.exit(1)

print(agent.SD_INFO + f"policy profile {profile['name']!r}: removal step {step}", file=sys.stderr)
json.dump(result, fp=sys.stdout)
