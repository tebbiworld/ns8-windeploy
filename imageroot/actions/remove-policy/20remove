# Remove a policy profile, in one or two steps.
#
# Windows removes registry policy and restores user rights by itself
# when the GPO is gone. Audit settings and registry values outside the
# policy keys stay on the computers as they were set (see policygen).
# For those the step "reset" changes the GPO to write the
# Windows defaults and leaves it linked; the step "delete" deletes the
# GPO, when the computers have seen the defaults. A profile without such
# settings is deleted at once.

import copy
import datetime
import json
import sys

import agent
import policygen
import wdcommon

request = json.load(sys.stdin)

with wdcommon.policies_locked() as data:
    profile = next((p for p in data["profiles"] if p["id"] == request["id"]), None)
    if profile is None:
        agent.set_status("validation-failed")
        json.dump([{"field": "id", "parameter": "id", "value": request["id"], "error": "profile_not_found"}], fp=sys.stdout)
        sys.exit(3)
    before = copy.deepcopy(profile["settings"])
    on = [sid for sid, entry in before.items() if entry["state"] == "on"]
    after = policygen.after_removal(before, on)
    step = request["step"]
    if step == "reset" and not after:
        step = "delete"  # nothing stays on the computers
    try:
        if step == "reset":
            profile["settings"] = after
            files, extensions = wdcommon.build_policy_files(profile)
            res = wdcommon.run_tool({"op": "apply", "guid": profile["gpo_guid"], "files": files, "backup_dir": "/backup",
                                     "machine_extensions": extensions})
            wdcommon.prune_backups(profile["gpo_guid"])
            profile["version"] = res["version"]
            profile["state"] = "resetting"
            profile["changed"] = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="seconds")
        else:
            if profile.get("gpo_guid"):
                wdcommon.delete_gpo(profile["gpo_guid"], profile.get("link_targets", []))
            data["profiles"] = [p for p in data["profiles"] if p["id"] != request["id"]]
    except (wdcommon.ToolError, ValueError, policygen.PolicyError) as ex:
        print(agent.SD_ERR + "removing the policy profile failed: " + str(ex), file=sys.stderr)
        sys.exit(1)
    wdcommon.log_policy_change(profile["name"], "reset" if step == "reset" else "deleted", request["reason"],
                               before, profile["settings"] if step == "reset" else {})

json.dump({"step": step, "left_on_computers": sorted(sid for sid in on if policygen.is_tattoo(sid)) if step == "delete" else []},
          fp=sys.stdout)
