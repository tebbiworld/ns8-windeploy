{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "create-dns-zone input",
    "$id": "http://schema.nethserver.org/windeploy/create-dns-zone-input.json",
    "description": "Create an internal DNS zone: a forward zone by name or the reverse zone of a network",
    "examples": [
        {
            "zone": "lab.example.net",
            "grant": true,
            "admin_user": "administrator",
            "admin_password": "Secret-1234"
        },
        {
            "network": "192.168.1.0/24",
            "admin_user": "administrator",
            "admin_password": "Secret-1234"
        }
    ],
    "type": "object",
    "required": [
        "admin_user",
        "admin_password"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "network": {
            "description": "Network of a reverse zone: IPv4 with /8, /16 or /24, IPv6 on a nibble",
            "type": "string",
            "minLength": 3,
            "maxLength": 60,
            "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$"
        },
        "grant": {
            "description": "Give the module group the right to change the records of the new zone",
            "type": "boolean"
        },
        "admin_user": {
            "type": "string",
            "minLength": 1,
            "maxLength": 104,
            "pattern": "^[^\\x00-\\x1f]+$"
        },
        "admin_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
        }
    },
    "oneOf": [
        {
            "required": [
                "zone"
            ]
        },
        {
            "required": [
                "network"
            ]
        }
    ]
}
