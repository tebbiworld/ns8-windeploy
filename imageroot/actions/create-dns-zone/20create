# Create an internal DNS zone: a forward zone by its name, or the reverse
# zone of a network. Needs domain admin credentials; they are used for
# this request only, never stored or logged. The module group gets its
# rights on the new zone unless "grant" is false.

import json
import sys

import agent
import dnsrules
import wdcommon

request = json.load(sys.stdin)
try:
    if request.get("network"):
        zone = dnsrules.reverse_zone(request["network"])
    else:
        zone = dnsrules.check_zone(request.get("zone", ""))
except ValueError as ex:
    wdcommon.dns_failed(ex, "network" if request.get("network") else "zone")
try:
    result = wdcommon.run_tool({
        "op": "dns_create_zone", "zone": zone, "grant": request.get("grant", True),
        "admin_user": request["admin_user"], "admin_password": request["admin_password"],
    }, timeout=120)
except wdcommon.ToolError as ex:
    wdcommon.dns_failed(ex, "admin_password" if ex.bad_credentials or ex.code == "admin_not_allowed" else "zone")
except ValueError as ex:
    wdcommon.dns_failed(ex, "zone")

wdcommon.log_dns_change("zone_created", zone, None, None)
print(agent.SD_NOTICE + f"DNS zone {zone} created", file=sys.stderr)
json.dump(result, fp=sys.stdout)
