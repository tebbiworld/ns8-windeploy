{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "save-deployment input",
    "$id": "http://schema.nethserver.org/windeploy/save-deployment-input.json",
    "description": "Create or update a deployment: one GPO with one scheduled task per winget package",
    "examples": [
        {
            "name": "Nextcloud client",
            "packages": [{"id": "Nextcloud.NextcloudDesktop", "mode": "upgrade"}],
            "schedule": {"frequency": "weekly", "days": ["Monday"], "time": "12:30", "start_date": "2026-09-28", "random_delay_minutes": 30},
            "delivery": "sysvol",
            "link_targets": ["DC=ad,DC=example,DC=com"]
        }
    ],
    "type": "object",
    "required": ["name", "packages", "schedule", "link_targets"],
    "properties": {
        "id": {"type": "string", "pattern": "^[0-9a-f]{12}$", "description": "Existing deployment; omit to create one"},
        "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[^\\r\\n\\x00]+$"},
        "packages": {
            "type": "array", "minItems": 1, "maxItems": 50,
            "items": {
                "type": "object", "required": ["id"],
                "properties": {
                    "id": {"type": "string", "minLength": 1, "maxLength": 128},
                    "mode": {"type": "string", "enum": ["upgrade", "install"]}
                }
            }
        },
        "schedule": {
            "type": "object", "required": ["frequency", "time", "start_date"],
            "properties": {
                "frequency": {"type": "string", "enum": ["daily", "weekly"]},
                "days": {"type": "array", "items": {"type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]}},
                "time": {"type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"},
                "start_date": {"type": "string", "format": "date"},
                "random_delay_minutes": {"type": "integer", "minimum": 0, "maximum": 1440}
            }
        },
        "delivery": {"type": "string", "enum": ["sysvol", "embedded"]},
        "link_targets": {"type": "array", "maxItems": 20, "items": {"type": "string", "minLength": 3, "maxLength": 512}}
    }
}
