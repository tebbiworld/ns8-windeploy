# Create or update a deployment.
#
# Order: validate everything offline, create the GPO if needed, write the
# files (gpowrite bumps the version and keeps a backup of the previous
# files), adjust the links, and only then store the deployment. If AD
# refuses a step the stored list keeps its previous state; a GPO created
# in this run is removed again.

import copy
import json
import os
import sys

import agent
import gpogen
import wdcommon
import wingetindex

request = json.load(sys.stdin)


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


# --- offline validation ----------------------------------------------------
ids = [p["id"] for p in request["packages"]]
if len(set(i.lower() for i in ids)) != len(ids):
    fail("packages", ids, "duplicate_package")
state = wdcommon.state_dir()
for pid in ids:
    if not wingetindex.valid_package_id(pid):
        fail("packages", pid, "invalid_package_id")
    try:
        if wingetindex.lookup(state, pid) is None:
            fail("packages", pid, "package_not_in_index")
    except wingetindex.IndexError_:
        fail("packages", pid, "index_missing")
schedule = request["schedule"]
if schedule["frequency"] == "weekly" and not schedule.get("days"):
    fail("schedule.days", [], "weekday_required")

settings = wdcommon.connection_settings()
try:
    wdcommon.validate_connection(settings)
except ValueError as ex:
    print(agent.SD_ERR + str(ex), file=sys.stderr)
    fail("domain", settings.get("domain", ""), "not_configured")

# Link targets: only the domain root and existing organizational units
# (Domain Controllers is not offered). Checked before anything is written.
if request["link_targets"]:
    try:
        valid = {t["dn"].lower() for t in wdcommon.run_tool({"op": "targets"}, settings=settings, timeout=120)}
    except (wdcommon.ToolError, ValueError) as ex:
        print(agent.SD_ERR + "cannot read the link targets: " + str(ex), file=sys.stderr)
        sys.exit(1)
    for dn in request["link_targets"]:
        if dn.lower() not in valid:
            fail("link_targets", dn, "link_target_not_found")

# The whole read-modify-write runs under the lock of deployments.json:
# a save or "run now" at the same time waits instead of being overwritten.
# An exit in the block (validation error, AD failure) leaves the file as
# it was.
with wdcommon.deployments_locked() as data:
    current = data["deployments"]
    old = None
    if request.get("id"):
        old = next((d for d in current if d["id"] == request["id"]), None)
        if old is None:
            fail("id", request["id"], "deployment_not_found")
        if old.get("pending_delete"):
            fail("id", request["id"], "removal_pending")
    for d in current:
        if d["name"].lower() == request["name"].lower() and d["id"] != request.get("id"):
            fail("name", request["name"], "name_in_use")

    deployment = copy.deepcopy(old) if old else {"id": wdcommon.new_id(), "gpo_guid": "", "link_targets": [], "_scripts": []}
    old_packages = {p["id"]: p for p in (old or {}).get("packages", [])}
    deployment["name"] = request["name"]
    deployment["schedule"] = {k: v for k, v in schedule.items() if k in ("frequency", "days", "time", "start_date", "random_delay_minutes")}
    deployment["delivery"] = request.get("delivery") or os.environ.get("DEFAULT_DELIVERY", "sysvol")
    deployment.pop("run_now_id", None)  # one id per deployment: before 0.1
    deployment["packages"] = []
    for p in request["packages"]:
        entry = {"id": p["id"], "mode": p.get("mode", "upgrade")}
        # same tasks on the clients; a pending "run now" stays as it is
        for key in ("task_uid", "now_uid", "now_run_id", "scope"):
            if old_packages.get(p["id"], {}).get(key):
                entry[key] = old_packages[p["id"]][key]
        deployment["packages"].append(entry)
    # The tasks run as SYSTEM: refuse packages that only install per user.
    for pid in wdcommon.update_scopes(deployment):
        fail("packages", pid, "user_scope_only")

    # Generate once offline: bad input fails here, before AD is touched.
    probe = copy.deepcopy(deployment)
    probe["gpo_guid"] = probe["gpo_guid"] or "{00000000-0000-0000-0000-000000000001}"
    try:
        wdcommon.build_files(probe, settings)
    except gpogen.GenError as ex:
        print(agent.SD_ERR + str(ex), file=sys.stderr)
        fail("packages", ids, "generation_failed")

    # --- AD ----------------------------------------------------------------
    # DNs are compared without case, like AD does: a DN that only changes
    # its case is the same link target.
    wanted = list({dn.lower(): dn for dn in request["link_targets"]}.values())
    wanted_keys = {dn.lower() for dn in wanted}
    linked_keys = {dn.lower() for dn in deployment["link_targets"]}
    created = False
    try:
        agent.set_progress(10)
        if not deployment["gpo_guid"]:
            res = wdcommon.run_tool({"op": "create", "display_name": "windeploy: " + deployment["name"]}, settings=settings)
            deployment["gpo_guid"] = res["guid"]
            created = True
        agent.set_progress(40)
        files = wdcommon.build_files(deployment, settings)
        # the display name follows a renamed deployment (LDAP and GPT.INI)
        res = wdcommon.run_tool({"op": "apply", "guid": deployment["gpo_guid"], "files": files,
                                 "backup_dir": "/backup", "display_name": "windeploy: " + deployment["name"]},
                                settings=settings)
        deployment["version"] = res["version"]
        wdcommon.prune_backups(deployment["gpo_guid"])
        agent.set_progress(70)
        for dn in wanted:
            if dn.lower() not in linked_keys:
                wdcommon.run_tool({"op": "link", "guid": deployment["gpo_guid"], "target_dn": dn}, settings=settings)
        for dn in deployment["link_targets"]:
            if dn.lower() not in wanted_keys:
                wdcommon.run_tool({"op": "unlink", "guid": deployment["gpo_guid"], "target_dn": dn}, settings=settings)
        deployment["link_targets"] = wanted
    except Exception as ex:
        # Any failure (also a timeout of podman): a GPO created in this run
        # is removed again, it would never show in the UI otherwise.
        print(agent.SD_ERR + f"saving the deployment failed: {type(ex).__name__}: {ex}", file=sys.stderr)
        if created:
            try:
                for dn in wanted:
                    wdcommon.run_tool({"op": "unlink", "guid": deployment["gpo_guid"], "target_dn": dn}, settings=settings)
                wdcommon.run_tool({"op": "delete", "guid": deployment["gpo_guid"]}, settings=settings)
                wdcommon.remove_backups(deployment["gpo_guid"])
            except Exception as cleanup:
                print(agent.SD_ERR + f"could not remove the new GPO {deployment['gpo_guid']}: {cleanup}", file=sys.stderr)
        if isinstance(ex, (wdcommon.ToolError, ValueError)):
            sys.exit(1)
        raise

    data["deployments"] = [d for d in current if d["id"] != deployment["id"]] + [deployment]

agent.set_progress(100)
print(agent.SD_INFO + f"deployment {deployment['name']!r} saved in GPO {deployment['gpo_guid']} version {deployment.get('version')}", file=sys.stderr)
json.dump({"id": deployment["id"], "gpo_guid": deployment["gpo_guid"], "version": deployment.get("version")}, fp=sys.stdout)
