import json
import sys

import agent
import wdcommon

try:
    targets = wdcommon.run_tool({"op": "targets"}, timeout=120)
except (wdcommon.ToolError, ValueError) as ex:
    print(agent.SD_ERR + str(ex), file=sys.stderr)
    sys.exit(1)
json.dump({"targets": targets}, fp=sys.stdout)
