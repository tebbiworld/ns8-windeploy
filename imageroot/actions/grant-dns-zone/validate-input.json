{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "grant-dns-zone input",
    "$id": "http://schema.nethserver.org/windeploy/grant-dns-zone-input.json",
    "description": "Give the module group the right to change the records of a zone, or take it away",
    "examples": [
        {
            "zone": "ad.example.com",
            "grant": true,
            "admin_user": "administrator",
            "admin_password": "Secret-1234"
        }
    ],
    "type": "object",
    "required": [
        "zone",
        "admin_user",
        "admin_password"
    ],
    "additionalProperties": false,
    "properties": {
        "zone": {
            "type": "string",
            "minLength": 1,
            "maxLength": 253,
            "pattern": "^[A-Za-z0-9_.-]+$"
        },
        "grant": {
            "type": "boolean"
        },
        "admin_user": {
            "type": "string",
            "minLength": 1,
            "maxLength": 104,
            "pattern": "^[^\\x00-\\x1f]+$"
        },
        "admin_password": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
        }
    }
}
