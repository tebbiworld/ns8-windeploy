# Give the module group the right to change the records of a zone, or
# take it away. Needs domain admin credentials; they are used for this
# request only, never stored or logged.

import json
import sys

import agent
import dnsrules
import wdcommon

request = json.load(sys.stdin)
try:
    zone = dnsrules.check_zone(request["zone"])
    result = wdcommon.run_tool({
        "op": "dns_delegate", "zone": zone, "grant": request.get("grant", True),
        "admin_user": request["admin_user"], "admin_password": request["admin_password"],
    }, timeout=120)
except wdcommon.ToolError as ex:
    if ex.access_denied:
        ex.code = "admin_not_allowed"
    wdcommon.dns_failed(ex, "admin_password")
except ValueError as ex:
    wdcommon.dns_failed(ex, "zone")

wdcommon.log_dns_change("granted" if result["granted"] else "revoked", zone, None, None)
print(agent.SD_NOTICE + f"DNS {zone}: rights of the module group {'given' if result['granted'] else 'taken away'}", file=sys.stderr)
json.dump(result, fp=sys.stdout)
