# Copy the connection settings of the original instance; the password
# comes with state/passwords.env.
#
# A move ("replace": the original is removed afterwards) keeps the
# deployments and policy profiles: the new instance manages the same GPOs.
# A copy starts without them, otherwise two instances would manage the same GPOs
# and removing a deployment in one would break the other.

import json
import os
import shutil
import sys

import agent
import wdcommon

request = json.load(sys.stdin)
env = agent.read_envfile("environment.clone-module")
KEEP = ["GPO_DOMAIN", "GPO_DC_HOST", "GPO_DC_IP", "GPO_REALM", "GPO_WORKGROUP", "GPO_USER", "DEFAULT_DELIVERY"]
agent.mset_env({k: env[k] for k in KEEP if k in env})

if not request.get("replace"):
    for name in (wdcommon.DEPLOYMENTS, wdcommon.POLICIES, wdcommon.POLICY_LOG, wdcommon.DNS_LOG, "rights.json"):
        try:
            os.remove(name)
        except FileNotFoundError:
            pass
    shutil.rmtree(wdcommon.BACKUP_DIR, ignore_errors=True)
    shutil.rmtree(wdcommon.DNS_BACKUP_DIR, ignore_errors=True)
    print(agent.SD_NOTICE + "clone starts without deployments", file=sys.stderr)
