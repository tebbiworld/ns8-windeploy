# Delete one record.

import json
import sys

import agent
import dnsrules
import wdcommon

request = json.load(sys.stdin)
try:
    dnsrules.check_zone(request["zone"])
    result = wdcommon.run_tool({
        "op": "dns_delete", "zone": request["zone"], "name": request["name"], "type": request["type"],
        "data": request["data"], "pointer": bool(request.get("pointer")),
    }, timeout=120)
except (wdcommon.ToolError, ValueError) as ex:
    wdcommon.dns_failed(ex)

wdcommon.log_dns_change("deleted", result["zone"], {k: result[k] for k in ("name", "type", "data")}, None,
                        result["pointer"])
print(agent.SD_INFO + f"DNS {result['zone']}: {result['name']} {result['type']} {result['data']} deleted", file=sys.stderr)
json.dump(result, fp=sys.stdout)
