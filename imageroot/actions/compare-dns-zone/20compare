# Compare the records of an internal zone the module may change with the
# public DNS. The names of the zone are sent to a public resolver over
# HTTPS. Nothing is changed.

import json
import sys

import agent
import dnscompare
import dnsrules
import wdcommon

request = json.load(sys.stdin)
try:
    zone = dnsrules.check_zone(request["zone"])
except ValueError as ex:
    wdcommon.dns_failed(ex, "zone")
if zone.endswith(".arpa"):
    json.dump({"zone": zone, "public": False, "rows": [], "skipped": 0}, fp=sys.stdout)
    sys.exit(0)

try:
    public = dnscompare.is_public_zone(zone)
    rows, skipped = [], 0
    if public:
        records = wdcommon.run_tool({"op": "dns_records", "zone": zone}, timeout=180)
        agent.set_progress(30)
        rows, skipped = dnscompare.compare(zone, records)
except dnscompare.LookupError_ as ex:
    print(agent.SD_ERR + str(ex), file=sys.stderr)
    agent.set_status("validation-failed")
    json.dump([{"field": "zone", "parameter": "zone", "value": zone, "error": "public_dns_unreachable"}], fp=sys.stdout)
    sys.exit(3)
except (wdcommon.ToolError, ValueError) as ex:
    wdcommon.dns_failed(ex, "zone")

# where the public side can be changed from this cluster, if at all
try:
    helpers = wdcommon.dnshelper_instances()
except Exception:
    helpers = []
json.dump({"zone": zone, "public": public, "rows": rows, "skipped": skipped,
           "resolver": dnscompare.RESOLVERS[0][0], "dnshelper": helpers}, fp=sys.stdout)
