# Retire a foreign GPO in steps (see pypkg/removal.py and pypkg/retire.py):
# start and cancel (domain admin credentials, used for this request
# only, never stored or logged), or delete when the waiting period is
# over (service account, also the daily timer).
# Only the DC of the settings is changed.

import json
import sys

import agent
import removal
import retire
import wdcommon

request = json.load(sys.stdin)
step = request["step"]


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


if step in ("start", "cancel") and not (request.get("admin_user") and request.get("admin_password")):
    fail("admin_password", "", "admin_required")

with wdcommon.retired_locked() as data:
    try:
        if step == "start":
            record = removal.start_retire(data, request["guid"], request["reason"], request["admin_user"],
                                          request["admin_password"], request.get("confirm_registry", []),
                                          request.get("confirm_audit", False), request.get("days"))
            result = {"step": step, "until": record["pending_delete"]["until"], "changes": record["changes"]}
        elif step == "cancel":
            removal.cancel_retire(data, request["guid"], request["reason"], request["admin_user"],
                                  request["admin_password"])
            result = {"step": step}
        else:
            removal.purge_retire(data, request["guid"], request["reason"])
            result = {"step": step}
    except removal.RemovalError as ex:
        fail("step", step, ex.code)
    except retire.RetireError as ex:
        print(agent.SD_ERR + f"retiring the GPO ({step}) refused: {ex}", file=sys.stderr)
        fail("guid", request["guid"], ex.code)
    except wdcommon.ToolError as ex:
        if step in ("start", "cancel") and (ex.bad_credentials or ex.access_denied):
            if ex.access_denied:
                ex.code = "admin_not_allowed"
            wdcommon.dns_failed(ex, "admin_password", account=request["admin_user"])
        print(agent.SD_ERR + f"retiring the GPO ({step}) failed: {ex}", file=sys.stderr)
        sys.exit(1)
    except ValueError as ex:
        print(agent.SD_ERR + f"retiring the GPO ({step}) failed: {ex}", file=sys.stderr)
        sys.exit(1)

print(agent.SD_INFO + f"GPO {request['guid']}: retirement step {step}", file=sys.stderr)
json.dump(result, fp=sys.stdout)
