# Copy the connection settings of the original instance. The password
# comes back with state/passwords.env, the deployments with
# state/deployments.json (both in etc/state-include.conf).

import json
import sys

import agent

request = json.load(sys.stdin)
env = request["environment"]

KEEP = ["GPO_DOMAIN", "GPO_DC_HOST", "GPO_DC_IP", "GPO_REALM", "GPO_WORKGROUP", "GPO_USER", "DEFAULT_DELIVERY", "DELETE_GRACE_DAYS"]
agent.mset_env({k: env[k] for k in KEEP if k in env})
