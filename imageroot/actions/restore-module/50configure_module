# Re-apply the restored settings with every field configure-module
# accepts (the password is already in passwords.env: empty keeps it).

import os
import sys

import agent

env = os.environ
if not env.get("GPO_USER"):
    print(agent.SD_NOTICE + "the backup has no service account: configure the module from the UI", file=sys.stderr)
    sys.exit(0)

data = {
    "domain": env.get("GPO_DOMAIN", ""),
    "dc_host": env.get("GPO_DC_HOST", ""),
    "dc_ip": env.get("GPO_DC_IP", ""),
    "realm": env.get("GPO_REALM", ""),
    "workgroup": env.get("GPO_WORKGROUP", ""),
    "username": env["GPO_USER"],
    "password": "",
    "default_delivery": env.get("DEFAULT_DELIVERY", "sysvol"),
}
response = agent.tasks.run(agent_id=env["AGENT_ID"], action="configure-module", data=data)
agent.assert_exp(response["exit_code"] == 0, "The configure-module subtask failed!")
