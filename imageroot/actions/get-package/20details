import json
import sys

import agent
import wdcommon
import wingetindex

request = json.load(sys.stdin)
if not wingetindex.valid_package_id(request["id"]):
    agent.set_status("validation-failed")
    json.dump([{"field": "id", "parameter": "id", "value": request["id"], "error": "invalid_package_id"}], fp=sys.stdout)
    sys.exit(3)
try:
    details = wingetindex.details(wdcommon.state_dir(), request["id"])
except Exception as ex:
    print(agent.SD_ERR + f"{type(ex).__name__}: {ex}", file=sys.stderr)
    sys.exit(1)
json.dump(details, fp=sys.stdout)
