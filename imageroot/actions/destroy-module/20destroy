# Removing the module does not touch AD: the GPOs of the deployments stay
# linked and keep running on the clients. They are listed in the log so
# the admin can remove them (or remove the deployments first).

import json
import subprocess
import sys

import agent
import wdcommon

subprocess.run(["systemctl", "--user", "disable", "--now", "windeploy-index.timer"], check=False)
for d in wdcommon.read_deployments()["deployments"]:
    if d.get("gpo_guid"):
        print(agent.SD_WARNING + f"GPO {d['gpo_guid']} ({d['name']}) stays in AD, linked to {', '.join(d.get('link_targets', [])) or 'nothing'}",
              file=sys.stderr)
