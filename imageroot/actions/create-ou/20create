# Create an empty organizational unit (after the admin confirmed it in the
# deployment editor). Needs the optional delegated right to create OUs.

import json
import sys

import agent
import wdcommon

request = json.load(sys.stdin)
try:
    result = wdcommon.run_tool({"op": "create_ou", "dn": request["dn"]}, timeout=120)
except (wdcommon.ToolError, ValueError) as ex:
    msg = str(ex)
    print(agent.SD_ERR + "creating the OU failed: " + msg, file=sys.stderr)
    agent.set_status("validation-failed")
    if "INSUFFICIENT_ACCESS" in msg or "(50," in msg:
        error = "ou_create_not_allowed"
    elif "parent" in msg:
        error = "ou_parent_missing"
    else:
        error = "ou_create_failed"
    json.dump([{"field": "dn", "parameter": "dn", "value": request["dn"], "error": error}], fp=sys.stdout)
    sys.exit(3)
json.dump(result, fp=sys.stdout)
