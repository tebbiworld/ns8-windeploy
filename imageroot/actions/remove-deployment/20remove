# Remove a deployment together with its GPO: unlink it, delete it. The
# tasks carry removePolicy, so every computer that had them deletes them
# at its next policy refresh. Installed software stays.

import json
import sys

import agent
import wdcommon

request = json.load(sys.stdin)

with wdcommon.deployments_locked() as data:
    deployment = next((d for d in data["deployments"] if d["id"] == request["id"]), None)
    if deployment is None:
        agent.set_status("validation-failed")
        json.dump([{"field": "id", "parameter": "id", "value": request["id"], "error": "deployment_not_found"}], fp=sys.stdout)
        sys.exit(3)

    guid = deployment.get("gpo_guid")
    if guid:
        try:
            wdcommon.delete_gpo(guid, deployment.get("link_targets", []))
        except (wdcommon.ToolError, ValueError) as ex:
            print(agent.SD_ERR + "removing the deployment failed: " + str(ex), file=sys.stderr)
            sys.exit(1)
    data["deployments"] = [d for d in data["deployments"] if d["id"] != request["id"]]

json.dump({"removed": True, "gpo_deleted": bool(guid)}, fp=sys.stdout)
