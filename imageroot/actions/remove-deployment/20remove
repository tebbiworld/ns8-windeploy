import json
import sys

import agent
import wdcommon

request = json.load(sys.stdin)
current = wdcommon.read_deployments()["deployments"]
deployment = next((d for d in current if d["id"] == request["id"]), None)
if deployment is None:
    agent.set_status("validation-failed")
    json.dump([{"field": "id", "parameter": "id", "value": request["id"], "error": "deployment_not_found"}], fp=sys.stdout)
    sys.exit(3)

guid = deployment.get("gpo_guid")
if guid:
    try:
        for dn in deployment.get("link_targets", []):
            wdcommon.run_tool({"op": "unlink", "guid": guid, "target_dn": dn})
        if request.get("delete_gpo"):
            wdcommon.run_tool({"op": "delete", "guid": guid})
    except (wdcommon.ToolError, ValueError) as ex:
        print(agent.SD_ERR + "removing the deployment failed: " + str(ex), file=sys.stderr)
        sys.exit(1)

with wdcommon.deployments_locked() as data:
    data["deployments"] = [d for d in data["deployments"] if d["id"] != request["id"]]
json.dump({"removed": True, "gpo_deleted": bool(guid and request.get("delete_gpo"))}, fp=sys.stdout)
