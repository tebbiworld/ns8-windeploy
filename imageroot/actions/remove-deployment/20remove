# Remove a deployment in steps (see pypkg/removal.py): start, cancel, or
# delete when the waiting period is over. Installed software stays.

import json
import sys

import agent
import removal
import wdcommon

request = json.load(sys.stdin)


def fail(field, value, error):
    agent.set_status("validation-failed")
    json.dump([{"field": field, "parameter": field, "value": value, "error": error}], fp=sys.stdout)
    sys.exit(3)


with wdcommon.deployments_locked() as data:
    deployment = next((d for d in data["deployments"] if d["id"] == request["id"]), None)
    if deployment is None:
        fail("id", request["id"], "deployment_not_found")
    step = request["step"]
    try:
        if step == "start":
            pending = removal.start_deployment(deployment, request["reason"], request.get("days"))
            result = {"step": step, "until": pending["until"]}
        elif step == "cancel":
            removal.cancel_deployment(deployment, request["reason"])
            result = {"step": step}
        else:
            removal.purge_deployment(data, deployment, request["reason"])
            result = {"step": step, "gpo_deleted": bool(deployment.get("gpo_guid"))}
    except removal.RemovalError as ex:
        fail("step", step, ex.code)
    except (wdcommon.ToolError, ValueError) as ex:
        print(agent.SD_ERR + f"removing the deployment ({step}) failed: {ex}", file=sys.stderr)
        sys.exit(1)

print(agent.SD_INFO + f"deployment {deployment['name']!r}: removal step {step}", file=sys.stderr)
json.dump(result, fp=sys.stdout)
