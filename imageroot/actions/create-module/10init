# Prepare the state files: the secrets file (0600) and the deployment list.

import json
import os

import agent
import modsecrets

modsecrets.ensure({})
if not os.path.exists("deployments.json"):
    with open("deployments.json", "w") as f:
        json.dump({"deployments": []}, f)
agent.set_env("DEFAULT_DELIVERY", "sysvol")
